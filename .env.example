# 필수: Anthropic(Claude) API 키 — https://console.anthropic.com
ANTHROPIC_API_KEY=

# 선택: 사용할 모델 (기본값 claude-opus-5-5)
# LLM_MODEL=claude-opus-5-5

# 선택: 인스타그램 GraphQL doc_id (인스타 쪽 변경으로 자동 추출이 깨질 때 교체)
# IG_DOC_ID=8845758582119845

# 선택: 데모 모드. 1로 두면 AI 키 없이 예시 문장으로 화면 흐름만 확인 (실서비스에서는 비워 두세요)
# MOCK_LLM=1

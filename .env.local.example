# 이 파일을 .env.local 로 복사해서 값을 채우세요. (Vercel에서는 Settings → Environment Variables)

# 필수: OpenAI API 키 — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 선택: 글 읽기(사진 속 글씨 포함)·각색 모델. 기본값 gpt-5-mini
#   ※ gpt-5-mini 는 2026-12-11 지원 종료 예정. OpenAI 권장 후속: gpt-5.6-terra
# OPENAI_TEXT_MODEL=gpt-5-mini

# 선택: 'AI 새 사진' 모델 (원본 사진을 입력으로 받는 편집 지원 모델). 기본값 gpt-image-2.5-sunburst
#   더 싸게: gpt-image-1-mini (단 2026-12-01 지원 종료 예정). gpt-image-1 은 이미 종료됨
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# 선택: AI 새 사진 품질 low | medium | high (기본 low, 더 고급스러운 사진은 medium — 비용 증가)
# OPENAI_IMAGE_QUALITY=low

# 선택: AI 새 사진 방식. describe(기본: 원본을 분석해 같은 요리를 새로 촬영 → 구도 확실히 다름, 글자·박스 안 남음)
#       edit(원본 사진을 편집 → 원본을 더 닮음)
# OPENAI_IMAGE_MODE=describe

# 선택: 0이면 편집 화면의 'AI 새 사진' 버튼을 숨김 (기본 켜짐, 바꾼 뒤 다시 빌드/배포 필요)
# NEXT_PUBLIC_ENABLE_IMAGE_GEN=0

# 선택: 인스타그램 GraphQL doc_id (인스타 쪽 변경으로 자동 추출이 깨질 때 교체)
# IG_DOC_ID=8845758582119845

# 선택: 데모 모드. 1이면 AI 키 없이 예시 문장/예시 사진으로 화면 흐름만 확인 (실서비스에서는 비워 두세요)
# MOCK_LLM=1
